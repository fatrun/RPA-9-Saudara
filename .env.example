# ==========================================
# RPA 9 SAUDARA - ENVIRONMENT CONFIGURATION (TEMPLATE)
# ==========================================

# Port & Server Host
PORT=3001
NODE_ENV=development

# Database Configuration (PostgreSQL)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=prefer
# Jika kosong atau "embedded", server akan menggunakan local embedded PostgreSQL storage (PGlite)
DATABASE_URL=embedded

# Security & JWT Configuration
JWT_SECRET=change_this_to_a_secure_random_string_in_production
PIN_SALT_ROUNDS=10
SESSION_MAX_AGE_MINUTES=480
INACTIVITY_LOGOUT_MINUTES=30
MAX_PIN_ATTEMPTS=5
PIN_LOCKOUT_MINUTES=5

# Google Sheets Sync Webhook (Kosongkan jika belum setup)
GOOGLE_SHEETS_WEBHOOK_URL=
GOOGLE_SHEETS_SECRET_TOKEN=

# WhatsApp Official RPA 9 Saudara
OFFICIAL_WHATSAPP=08882538925
